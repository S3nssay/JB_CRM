{
  "permissions": {
    "allow": [
      "Bash(powershell.exe -Command \"Get-Process node -ErrorAction SilentlyContinue | Select-Object Id\")",
      "Read(//tmp/claude/c--Users-ziaa-Dropbox-ZA-DEV-PROJECTS-JB-CRM/tasks/**)",
      "Bash(npx esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-context-monitor.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js"
  }
}
